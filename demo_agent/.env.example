# Hosted ESS-MCP demo agent configuration
# Copy to .env for local testing. Do not commit real tokens or secrets.

# -- LLM backend -----------------------------------------------------
# Option A: Azure OpenAI with Entra auth
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2025-03-01-preview

# Option B: GitHub Models fallback
GITHUB_TOKEN=ghp_...

# Optional overrides
# ESS_MODEL=gpt-5.4-1
# ESS_MAX_TURNS=25
# ESS_WEB_PORT=8091

# -- Hosted agent identity / Agent 365 metadata ---------------------
ESS_AGENT_DISPLAY_NAME=ESS Workday ServiceNow Agent
AZURE_TENANT_ID=<tenant-id>

# Values created by the Microsoft Entra Agent ID guided setup.
ENTRA_AGENT_BLUEPRINT_CLIENT_ID=<blueprint-app-id>
ENTRA_AGENT_BLUEPRINT_OBJECT_ID=<blueprint-application-object-id>
ENTRA_AGENT_BLUEPRINT_PRINCIPAL_ID=<blueprint-principal-service-principal-id>
ENTRA_AGENT_IDENTITY_OBJECT_ID=<agent-identity-service-principal-object-id>
ENTRA_AGENT_IDENTITY_CLIENT_ID=<agent-identity-client-id-if-issued>

# Microsoft Entra SDK for AgentID sidecar / token broker endpoint.
# The runtime calls this endpoint to get Agent Identity-backed assertions for
# downstream OAuth flows when ESS_<SERVER>_OAUTH_AUTH_METHOD requires it.
ENTRA_AGENT_ID_SDK_TOKEN_URL=http://localhost:8911/token
# ENTRA_AGENT_ID_SDK_TIMEOUT=15

# Agent 365 / Foundry correlation metadata for observability and registry views.
AZURE_FOUNDRY_PROJECT_ENDPOINT=https://<foundry-project>.services.ai.azure.com/api/projects/<project>
AZURE_FOUNDRY_AGENT_ID=<foundry-agent-id>

# -- Agent 365 / Purview / Defender tool-call observation --------------
# The demo agent emits one Agent 365 SDK execute_tool span per MCP tool call,
# plus a console/Log Analytics event named agent.tool_call.observed for local
# debugging. The A365 exporter posts spans to the Observability API when enabled.
ENABLE_OBSERVABILITY=true
ENABLE_A365_OBSERVABILITY=true
ENABLE_A365_OBSERVABILITY_EXPORTER=true
# managed_identity uses the Container App identity directly. For hosted S2S export,
# grant Agent365.Observability.OtelWrite and enable the S2S endpoint below.
# HTTP 403 from the exporter can also indicate missing Agent 365 Frontier/E7 tenant entitlement.
A365_OBSERVABILITY_TOKEN_SOURCE=managed_identity
# Managed identity uses app roles, so request .default. Agentic delegated token
# resolvers should use api://9b975845-388f-4429-889e-eab1ef63949c/Agent365.Observability.OtelWrite.
A365_OBSERVABILITY_TOKEN_SCOPE=api://9b975845-388f-4429-889e-eab1ef63949c/.default
# A365_OBSERVABILITY_DOMAIN_OVERRIDE=https://agent365.svc.cloud.microsoft
A365_OBSERVABILITY_USE_S2S_ENDPOINT=true
# A365_OBSERVABILITY_MANAGED_IDENTITY_CLIENT_ID=<user-assigned-mi-client-id-if-used>
# Optional generic OTLP collector path for sidecar/collector diagnostics.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://<otel-collector-endpoint>
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <collector-token>
OTEL_SERVICE_NAME=ess-demo-agent
ESS_OBSERVE_TOOL_PAYLOADS=true
# 0 means the app does not truncate payload attributes. Downstream telemetry
# systems may still apply their own size limits.
ESS_OBSERVE_TOOL_PAYLOAD_MAX_CHARS=0

# -- AI Gateway / governed MCP endpoints ----------------------------
# Preferred: route MCP through the Agent 365/Foundry/APIM gateway where policy
# can be attached. Per-server URLs override the base URL.
ESS_AI_GATEWAY_BASE_URL=https://<gateway-host>/ess-mcp
# ESS_WORKDAY_AI_GATEWAY_MCP_URL=https://<gateway-host>/ess-mcp/workday/mcp
# ESS_SERVICENOW_AI_GATEWAY_MCP_URL=https://<gateway-host>/ess-mcp/servicenow/mcp

# Local-development fallback only: direct MCP endpoints.
# ESS_WORKDAY_MCP_URL=https://your-host.azurecontainerapps.io/workday/mcp
# ESS_SERVICENOW_MCP_URL=https://your-host.azurecontainerapps.io/servicenow/mcp

# -- Workday OAuth for MCP bearer-token passthrough -----------------
ESS_WORKDAY_OAUTH_TOKEN_URL=https://<tenant>.workday.com/ccx/oauth2/<tenant>/token
ESS_WORKDAY_OAUTH_AUTHORIZATION_URL=https://<tenant>.workday.com/ccx/oauth2/<tenant>/authorize
ESS_WORKDAY_OAUTH_REDIRECT_URI=https://<agent-host>/oauth/workday/callback
ESS_WORKDAY_OAUTH_CLIENT_ID=<workday-client-id>
ESS_WORKDAY_OAUTH_CLIENT_SECRET=<store-in-container-app-secret-or-key-vault>
ESS_WORKDAY_OAUTH_SCOPE=<workday-scopes>
ESS_WORKDAY_OAUTH_AUTH_METHOD=agent_client_assertion
# ESS_WORKDAY_OAUTH_ASSERTION_SCOPE=api://<workday-oauth-app-id>/.default
# ESS_WORKDAY_OAUTH_ASSERTION_RESOURCE=<workday-audience>
# Alternative delegated/bootstrap mode: store the refresh token in a secret store,
# not in this file, and use it to mint short-lived access tokens at runtime.
# ESS_WORKDAY_OAUTH_GRANT_TYPE=refresh_token
# ESS_WORKDAY_OAUTH_REFRESH_TOKEN=<container-app-secret-or-key-vault-reference>

# Static access-token fallback has been intentionally removed from the hosted pattern.

# -- ServiceNow OAuth for MCP bearer-token passthrough --------------
ESS_SERVICENOW_OAUTH_TOKEN_URL=https://<instance>.service-now.com/oauth_token.do
ESS_SERVICENOW_OAUTH_AUTHORIZATION_URL=https://<instance>.service-now.com/oauth_auth.do
ESS_SERVICENOW_OAUTH_REDIRECT_URI=https://<agent-host>/oauth/servicenow/callback
ESS_SERVICENOW_OAUTH_CLIENT_ID=<servicenow-client-id>
ESS_SERVICENOW_OAUTH_CLIENT_SECRET=<store-in-container-app-secret-or-key-vault>
ESS_SERVICENOW_OAUTH_SCOPE=<servicenow-scopes>
ESS_SERVICENOW_OAUTH_AUTH_METHOD=agent_client_assertion
# ESS_SERVICENOW_OAUTH_ASSERTION_SCOPE=api://<servicenow-oauth-app-id>/.default
# ESS_SERVICENOW_OAUTH_ASSERTION_RESOURCE=<servicenow-audience>
# Alternative delegated/bootstrap mode: store the refresh token in a secret store,
# not in this file, and use it to mint short-lived access tokens at runtime.
# ESS_SERVICENOW_OAUTH_GRANT_TYPE=refresh_token
# ESS_SERVICENOW_OAUTH_REFRESH_TOKEN=<container-app-secret-or-key-vault-reference>

# Static access-token fallback has been intentionally removed from the hosted pattern.

# Supported ESS_<SERVER>_OAUTH_AUTH_METHOD values:
# - client_secret_post: standard client credentials with client_secret in body
# - client_secret_basic: standard client credentials with HTTP Basic auth
# - agent_client_assertion: client_credentials with Agent Identity JWT assertion
# - token_exchange: RFC 8693-style exchange using Agent Identity subject_token
# - refresh_token: delegated OAuth flow using a stored refresh token from an
#   earlier authorization-code bootstrap
# - none: send grant, client_id, scope/resource only