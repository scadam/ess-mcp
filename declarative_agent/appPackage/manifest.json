{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.25/MicrosoftTeams.schema.json",
    "manifestVersion": "1.25",
    "version": "${{AGENT_VERSION}}",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "Scott Adams, Microsoft",
        "websiteUrl": "https://www.microsoft.com",
        "privacyUrl": "https://www.microsoft.com/privacy",
        "termsOfUseUrl": "https://www.microsoft.com/termsofuse"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "Employee Self Service",
        "full": "Employee Self Service with MCP and MCP Apps for Workday, ServiceNow, Jira and Salesforce"
    },
    "description": {
        "short": "Employee Self Service with Microsoft Copilot using MCP",
        "full": "Employee Self Service with Microsoft Copilot using MCP and MCP Apps for Workday, ServiceNow, Jira, Coupa, Ariba and Salesforce"
    },
    "accentColor": "#FFFFFF",
    "supportsChannelFeatures": "tier1",
    "composeExtensions": [],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "copilotAgents": {
        "declarativeAgents": [            
            {
                "id": "declarativeAgent",
                "file": "declarativeAgent.json"
            }
        ]
    },
    "validDomains": ["*.azurecontainerapps.io"]
}