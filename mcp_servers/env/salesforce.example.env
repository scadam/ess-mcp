# Salesforce My Domain URL (required)
SALESFORCE_DOMAIN=yourorg.my.salesforce.com

# ── Authentication ──────────────────────────────────────────────────
# Auth mode controls how the server authenticates to Salesforce:
#   auto                – use the inbound `Authorization: Bearer` token if
#                         present, otherwise fall back to the OAuth 2.0
#                         Client Credentials flow (default).
#   oauth_bearer        – require an inbound bearer token, no fallback.
#   client_credentials  – always use Client Credentials, ignore inbound bearer.
SF_AUTH_MODE=auto

# Salesforce Connected App "Consumer Key" / "Consumer Secret"
# Required for the `auto` (fallback) and `client_credentials` auth modes.
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Salesforce REST API version (optional)
SF_API_VERSION=v59.0
