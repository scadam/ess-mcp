# Workday API configuration (required)
WORKDAY_BASE_URL=https://your-workday-host.workday.com
WORKDAY_TENANT=your_tenant_name

# RaaS custom report paths (owner/ReportName — no leading slash)
WORKDAY_SKILLS_REPORT=your_user/ESSMCPSkills
WORKDAY_LEARNING_REPORT=your_user/Required_Learning

# Optional no-auth MCP fallback for declarative agents.
# Use refresh_token only. Store secrets outside source control.
WORKDAY_OAUTH_TOKEN_URL=https://your-workday-host.workday.com/ccx/oauth2/your_tenant_name/token
WORKDAY_OAUTH_CLIENT_ID=<workday-client-id>
WORKDAY_OAUTH_CLIENT_SECRET=<workday-client-secret>
WORKDAY_OAUTH_REFRESH_TOKEN=<workday-refresh-token>
WORKDAY_OAUTH_GRANT_TYPE=refresh_token
WORKDAY_OAUTH_AUTH_METHOD=client_secret_post

# Used to resolve a default worker when no user bearer token exists.
# Prefer WORKDAY_DEFAULT_WORKER_ID when known; otherwise use the search endpoint.
WORKDAY_DEFAULT_WORKER_ID=
WORKDAY_DEFAULT_WORKER_SEARCH=Siva Vasireddy
